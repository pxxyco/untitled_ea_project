<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="it.unical.ea_project_javafx.controller.profile.TravelerDashboardController"
      spacing="20.0">
    <VBox spacing="4.0" styleClass="dashboard-heading">
        <Label styleClass="hero-title" text="La tua dashboard Traveler" />
        <Label styleClass="section-subtitle" text="Pronto per la tua prossima avventura? Ecco un riepilogo della tua attivita." />
    </VBox>

    <HBox spacing="16.0" styleClass="stats-row">
        <HBox fx:id="bookingStat" managed="false" visible="false" styleClass="profile-stat" HBox.hgrow="ALWAYS" spacing="14.0">
            <Label styleClass="stat-icon" text="BOOK" />
            <VBox>
                <Label fx:id="bookingValue" styleClass="stat-value" />
                <Label fx:id="bookingDetail" styleClass="stat-label" />
            </VBox>
        </HBox>
        <HBox fx:id="pointsStat" managed="false" visible="false" styleClass="profile-stat" HBox.hgrow="ALWAYS" spacing="14.0">
            <Label styleClass="stat-icon" text="XP" />
            <VBox>
                <Label fx:id="pointsValue" styleClass="stat-value" />
                <Label fx:id="pointsDetail" styleClass="stat-label" />
            </VBox>
        </HBox>
        <HBox fx:id="favoritesStat" managed="false" visible="false" styleClass="profile-stat" HBox.hgrow="ALWAYS" spacing="14.0">
            <Label styleClass="stat-icon" text="SAVE" />
            <VBox>
                <Label fx:id="favoritesValue" styleClass="stat-value" />
                <Label fx:id="favoritesDetail" styleClass="stat-label" />
            </VBox>
        </HBox>
    </HBox>

    <VBox spacing="16.0">
        <HBox alignment="CENTER_LEFT" styleClass="section-heading">
            <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                <Label styleClass="section-title" text="Scopri attivita e viaggi" />
                <Label styleClass="section-subtitle" text="Esplora le esperienze disponibili per il tuo prossimo viaggio." />
            </VBox>
            <HBox spacing="8.0">
                <Button styleClass="carousel-button" text="&lt;" />
                <Button styleClass="carousel-button" text="&gt;" />
            </HBox>
        </HBox>
        <HBox fx:id="activityContainer" spacing="20.0" styleClass="activity-row" />
    </VBox>

    <VBox spacing="16.0" styleClass="profile-section">
        <Label styleClass="section-title-small" text="I miei prossimi impegni" />
        <TableView fx:id="bookingsTable" prefHeight="190.0" styleClass="profile-table">
            <columns>
                <TableColumn fx:id="activityColumn" prefWidth="240.0" text="Attivita" />
                <TableColumn fx:id="dateColumn" prefWidth="160.0" text="Data e ora" />
                <TableColumn fx:id="locationColumn" prefWidth="160.0" text="Luogo" />
                <TableColumn fx:id="statusColumn" prefWidth="150.0" text="Stato" />
            </columns>
        </TableView>
    </VBox>
</VBox>
