<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="it.unical.ea_project_javafx.controller.LoginStepController"
      spacing="20.0">

    <Label styleClass="header-title" text="Login Form" />

    <VBox spacing="8.0">
        <Label styleClass="input-label" text="Email / Username" />
        <TextField fx:id="loginUsernameField" promptText="Enter your email or username" styleClass="custom-input" />
    </VBox>

    <VBox spacing="8.0">
        <Label styleClass="input-label" text="Password" />
        <PasswordField fx:id="loginPasswordField" promptText="Enter your password" styleClass="custom-input" />
    </VBox>

    <HBox alignment="CENTER_LEFT">
        <children>
            <CheckBox styleClass="custom-checkbox" text="Remember me" />
            <Region HBox.hgrow="ALWAYS" />
            <Hyperlink styleClass="custom-link" text="Forgot password?" />
        </children>
    </HBox>

    <Button fx:id="btnLogin" maxWidth="1.7976931348623157E308" onAction="#handleLoginSubmit" styleClass="btn-submit" text="Log In" />

    <HBox alignment="CENTER" spacing="5.0">
        <Label styleClass="switch-text" text="Don't have an account?" />
        <Hyperlink onAction="#goToRoleSelection" styleClass="custom-link-bold" text="Register" />
    </HBox>
</VBox>