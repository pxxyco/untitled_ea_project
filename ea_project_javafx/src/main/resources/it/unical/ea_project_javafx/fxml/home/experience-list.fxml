<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="it.unical.ea_project_javafx.controller.home.ExperienceListController"
      maxWidth="1000.0" spacing="15.0" VBox.vgrow="ALWAYS">

    <HBox alignment="CENTER_LEFT" spacing="10.0">
        <children>
            <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                <children>
                    <Label styleClass="section-title" text="Esperienze più apprezzate dai viaggiatori" wrapText="true" />
                    <Label styleClass="section-subtitle" text="Valutate da utenti reali che hanno partecipato alle attività" wrapText="true" />
                </children>
            </VBox>
            <Button fx:id="resetButton" onAction="#handleReset" styleClass="btn-search" text="Azzera ricerca" visible="false" managed="false" />
        </children>
    </HBox>

    <VBox fx:id="cardsContainer" spacing="16.0" VBox.vgrow="ALWAYS" />
    
    <VBox fx:id="loadingIndicatorBox" alignment="CENTER" spacing="8.0" visible="false" managed="false" style="-fx-padding: 10;">
        <children>
            <ProgressIndicator prefWidth="40.0" prefHeight="40.0" maxWidth="40.0" maxHeight="40.0"/>
            <Label text="Caricamento in corso..." styleClass="section-subtitle"/>
        </children>
    </VBox>

    <HBox alignment="CENTER" style="-fx-padding: 10 0 20 0;">
        <children>
            <Label fx:id="loadMoreLabel" text="Carica altro" onMouseClicked="#handleLoadMore" styleClass="load-more-label"  />
        </children>
    </HBox>
</VBox>