<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.effect.BoxBlur?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>

<StackPane stylesheets="@../css/styles.css" styleClass="root-container" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="it.unical.ea_project_javafx.controller.UserHomeController">
    
    <!-- Sfondo Immagine con Blur -->
    <ImageView fx:id="bgImageView" fitHeight="800" fitWidth="1280" preserveRatio="false">
        <image>
            <Image url="https://images.unsplash.com/photo-1464822759023-fed622ff2c3b?auto=format&amp;fit=crop&amp;w=1920&amp;q=80" />
        </image>
        <effect>
            <BoxBlur iterations="3" width="20" height="20" />
        </effect>
    </ImageView>

    <!-- Overlay Scuro -->
    <Pane styleClass="dark-overlay" />

    <!-- Main Layout -->
    <VBox styleClass="app-layout">
        
        <!-- Top Header -->
        <HBox styleClass="top-header">
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label style="-fx-font-size: 24px;" text="🏔️" />
                <Label styleClass="brand-title" text="EA Explorer" />
            </HBox>
            
            <Region HBox.hgrow="ALWAYS" />

            <!-- Profilo Menu -->
            <HBox fx:id="userProfileBox" onMouseClicked="#handleProfileClick" styleClass="user-profile-button" spacing="10">
                <StackPane>
                    <Circle radius="18" styleClass="avatar-bg" />
                    <Label fx:id="lblAvatar" styleClass="avatar-text" text="M" />
                </StackPane>
                <VBox alignment="CENTER_LEFT" spacing="2">
                    <Label fx:id="lblUserName" styleClass="user-name" text="Mario Rossi" />
                    <Label fx:id="lblUserEmail" styleClass="user-email" text="mario@example.com" />
                </VBox>
                <Label style="-fx-text-fill: rgba(255,255,255,0.6); -fx-font-size: 10px;" text="▼" />
            </HBox>
        </HBox>

        <!-- Content Area -->
        <ScrollPane fitToWidth="true" style="-fx-background: transparent; -fx-background-color: transparent;" VBox.vgrow="ALWAYS">
            <VBox spacing="24">
                <padding>
                    <Insets bottom="32" left="32" right="32" top="16" />
                </padding>

                <!-- Section Header -->
                <HBox alignment="CENTER_LEFT">
                    <VBox spacing="4">
                        <Label style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: white;" text="Scopri Attività &amp; Viaggi" />
                        <Label style="-fx-font-size: 13px; -fx-text-fill: rgba(255,255,255,0.6);" text="Trova le migliori esperienze organizzate vicino a te" />
                    </VBox>
                    <Region HBox.hgrow="ALWAYS" />
                    <HBox alignment="CENTER" spacing="8">
                        <TextField fx:id="txtSearch" prefWidth="280" promptText="Cerca per titolo, città o categoria..." styleClass="search-input" />
                        <Button onAction="#handleSearch" styleClass="btn-primary" text="Filtra" />
                    </HBox>
                </HBox>

                <!-- Dynamic Cards Grid -->
                <FlowPane fx:id="cardsGrid" hgap="20" vgap="20" />

                <!-- Table Bookings -->
                <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white;" text="I Miei Prossimi Impegni" />
                
                <TableView fx:id="bookingsTable" prefHeight="150">
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                    <columns>
                        <TableColumn fx:id="colActivity" text="Attività" />
                        <TableColumn fx:id="colDateTime" text="Data e Ora" />
                        <TableColumn fx:id="colLocation" text="Luogo" />
                        <TableColumn fx:id="colStatus" text="Stato Prenotazione" />
                    </columns>
                </TableView>
            </VBox>
        </ScrollPane>
    </VBox>
</StackPane>