<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>

<BorderPane xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="it.unical.ea_project_javafx.controller.NavbarController"
            styleClass="navbar">
    <left>
        <HBox alignment="CENTER_LEFT" spacing="16.0">
            <children>
                <Label styleClass="brand-logo" text="🧭" />
                <Separator orientation="VERTICAL" styleClass="nav-divider" />
                <HBox alignment="CENTER_LEFT" spacing="20.0" styleClass="nav-links">
                    <children>
                        <Label onMouseClicked="#handleEsperienze" styleClass="nav-item" text="Esperienze" />
                        <Label onMouseClicked="#handleItinerari" styleClass="nav-item" text="Itinerari Pubblici" />
                    </children>
                </HBox>
            </children>
        </HBox>
    </left>
    <right>
        <HBox alignment="CENTER_RIGHT" BorderPane.alignment="CENTER">
            <children>
                <Label onMouseClicked="#handleLogin" styleClass="btn-nav-login" text="Login" />
            </children>
        </HBox>
    </right>
    <padding>
        <Insets bottom="15.0" left="20.0" right="20.0" top="15.0" />
    </padding>
</BorderPane>