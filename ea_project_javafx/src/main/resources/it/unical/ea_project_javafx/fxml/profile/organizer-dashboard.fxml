<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="it.unical.ea_project_javafx.controller.profile.OrganizerDashboardController"
      spacing="20.0">
    <HBox alignment="CENTER_LEFT">
        <VBox spacing="4.0" HBox.hgrow="ALWAYS">
            <Label styleClass="section-title" text="Dashboard Organizzatore" />
            <Label styleClass="section-subtitle" text="Gestisci i tuoi eventi, le offerte e controlla le prenotazioni." />
        </VBox>
        <Button onAction="#handleNewActivity" styleClass="create-activity-button" text="+ Nuova attivita" />
    </HBox>

    <HBox spacing="16.0" styleClass="stats-row">
        <HBox fx:id="publishedStat" managed="false" visible="false" styleClass="profile-stat" HBox.hgrow="ALWAYS" spacing="14.0" />
        <HBox fx:id="subscribersStat" managed="false" visible="false" styleClass="profile-stat" HBox.hgrow="ALWAYS" spacing="14.0" />
        <HBox fx:id="revenueStat" managed="false" visible="false" styleClass="profile-stat" HBox.hgrow="ALWAYS" spacing="14.0" />
    </HBox>

    <VBox spacing="16.0">
        <Label styleClass="section-title-small" text="Le tue attivita gestite" />
        <HBox fx:id="managedActivitiesContainer" spacing="20.0" styleClass="activity-row" />
    </VBox>

    <VBox spacing="16.0">
        <Label styleClass="section-title-small" text="Ultimi utenti iscritti ai tuoi eventi" />
        <TableView fx:id="tableSubscribers" prefHeight="200.0" styleClass="profile-table">
            <columns>
                <TableColumn fx:id="colParticipant" prefWidth="220.0" text="Partecipante" />
                <TableColumn fx:id="colEmail" prefWidth="220.0" text="Email" />
                <TableColumn fx:id="colChosenActivity" prefWidth="250.0" text="Attivita scelta" />
                <TableColumn fx:id="colSubscriptionDate" prefWidth="180.0" text="Data iscrizione" />
            </columns>
        </TableView>
    </VBox>
</VBox>
